# Dataset files (large files, not for git)
dataset/
data/*.xlsx
data/*.csv
data/*.jsonl
!data/toxic_data/toxicity_*.jsonl
!data/toxic_data/toxicity_*.csv

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Output files (generated during runtime)
output/
# Keep data files but ignore generated outputs
!data/**/*.jsonl
!data/**/*.csv
*.json

# Model files (too large for git)
qwen_lora_finetuned/
qwen_lora_output/
*.bin
*.safetensors
*.pth
*.ckpt
# Checkpoint files
**/checkpoints/**/*.pt
**/checkpoints/**/optimizer.pt
**/checkpoints/**/scheduler.pt
**/checkpoints/**/trainer_state.json
models/**/checkpoints/

# Virtual environment
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test files
test_*.json
*_test.py

# Temporary files
*.tmp
*.bak

